---
import { InteractiveAura } from '../components/canvas/InteractiveAura';
import { CustomCursor } from '../components/cursor/CustomCursor';
import { Header } from '../components/navigation/Header';
import { HeroSection } from '../components/hero/HeroSection';
import { AboutSection } from '../components/about/AboutSection';
import { GameSection } from '../components/games/GameSection';
import { CosmicServicesExpedition } from '../components/services/CosmicServicesExpedition';
import { FoundersSection } from '../components/team/FoundersSection';
import { TriadPillars } from '../components/triad/TriadPillars';
import { ContactSection } from '../components/contact/ContactSection';
import { Footer } from '../components/footer/Footer';
import { SmoothScroll } from '../components/scroll/SmoothScroll';
import { TransitionSection } from '../components/transitions/TransitionSection';
import { CosmicSectionDivider } from '../components/navigation/CosmicSectionDivider';
import '../styles/global.css';
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/src/img/vigiltristudio_logo.png" />
    <title>Vigiltri Studio — Tiga yang Berjaga | Studio Game & Rekayasa IT</title>
    <meta
      name="description"
      content="Studio tiga orang yang membangun game dan sistem IT dengan ketelitian seorang penjaga malam — tenang, teliti, dan selalu ada saat dibutuhkan."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#08090C] text-slate-100 min-h-screen relative selection:bg-indigo-500 selection:text-white">
    <SmoothScroll client:load>
      <!-- Background Ambient Canvas -->
      <InteractiveAura client:load />

      <!-- High-End Magnetic Cursor -->
      <CustomCursor client:load />

      <!-- Minimalist Glass Header -->
      <Header client:load />

      <!-- Main Content Container with Transitions -->
      <main class="relative z-10">
        <TransitionSection client:load>
          <HeroSection client:load />
        </TransitionSection>

        <CosmicSectionDivider client:load label="BERKARYA DI RITME MALAM" />

        <TransitionSection client:load>
          <AboutSection client:load />
        </TransitionSection>

        <CosmicSectionDivider client:load label="PROYEK GAME UTAMA" />

        <TransitionSection client:load>
          <GameSection client:load />
        </TransitionSection>

        <CosmicSectionDivider client:load label="EKSPEDISI SOLUSI & LAYANAN" />

        <TransitionSection client:load>
          <CosmicServicesExpedition client:load />
        </TransitionSection>

        <CosmicSectionDivider client:load label="TIM FOUNDER" />

        <TransitionSection client:load>
          <FoundersSection client:load />
        </TransitionSection>

        <CosmicSectionDivider client:load label="FONDASI MUTU" />

        <TransitionSection client:load>
          <TriadPillars client:load />
        </TransitionSection>

        <CosmicSectionDivider client:load label="DISKUSI PROYEK" />

        <TransitionSection client:load>
          <ContactSection client:load />
        </TransitionSection>
      </main>

      <!-- Technical Studio Footer -->
      <Footer client:load />
    </SmoothScroll>
  </body>
</html>

